# ============ 默认通道（不写后缀） ============
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret
# 接收消息的目标（默认 open_id；也可用 chat_id 指定群）
FEISHU_RECEIVE_USER_ID=ou_xxxxxxxxxxxxxxxx
FEISHU_RECEIVE_ID_TYPE=open_id
# 连接模式：websocket（推荐，免公网）| poll
FEISHU_CONNECTION_MODE=websocket

# ============ 多通道：复制一份换后缀即可（A/B/C/D/E/F…） ============
# FEISHU_A_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_A_APP_SECRET=your_app_secret
# FEISHU_A_RECEIVE_USER_ID=ou_xxxxxxxxxxxxxxxx
# FEISHU_A_CONNECTION_MODE=websocket

# ============ 可选项 ============
# FEISHU_ENCRYPT_KEY / FEISHU_VERIFICATION_TOKEN  # poll 模式回调加密用
# FEISHU_SHOW_TOOL_USE=false                      # 关闭工具调用展示
# FEISHU_STREAMING_CARDS=false                    # 关闭流式卡片
# FEISHU_CWD=/path/to/your/project                # 指定 bot 工作目录
# PORT=18080                                      # 本地 HTTP API 端口
# PUBLIC_URL=                                     # web 通道外网地址（可选）
# MYCC_DATA_DIR=~/.mycc                           # 数据目录（会话/配对状态）
